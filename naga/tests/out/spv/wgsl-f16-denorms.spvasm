; SPIR-V
; Version: 1.3
; Generator: rspirv
; Bound: 33
OpCapability Shader
OpCapability Float16
OpCapability StorageBuffer16BitAccess
OpCapability UniformAndStorageBuffer16BitAccess
OpCapability StorageInputOutput16
OpCapability DenormPreserve
OpExtension "SPV_KHR_float_controls"
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %8 "before"
OpEntryPoint GLCompute %19 "half"
OpEntryPoint GLCompute %27 "after"
OpExecutionMode %8 LocalSize 1 1 1
OpExecutionMode %19 LocalSize 1 1 1
OpExecutionMode %27 LocalSize 1 1 1
OpExecutionMode %8 DenormPreserve 16
OpExecutionMode %19 DenormPreserve 16
OpExecutionMode %27 DenormPreserve 16
OpDecorate %4 DescriptorSet 0
OpDecorate %4 Binding 0
OpDecorate %5 Block
OpMemberDecorate %5 0 Offset 0
%2 = OpTypeVoid
%3 = OpTypeFloat 32
%5 = OpTypeStruct %3
%6 = OpTypePointer StorageBuffer %5
%4 = OpVariable  %6  StorageBuffer
%9 = OpTypeFunction %2
%10 = OpTypePointer StorageBuffer %3
%12 = OpTypeInt 32 0
%11 = OpConstant  %12  0
%14 = OpConstant  %3  1
%23 = OpTypeFloat 16
%29 = OpConstant  %3  2
%8 = OpFunction  %2  None %9
%7 = OpLabel
%13 = OpAccessChain  %10  %4 %11
OpBranch %15
%15 = OpLabel
%16 = OpLoad  %3  %13
%17 = OpFAdd  %3  %16 %14
OpStore %13 %17
OpReturn
OpFunctionEnd
%19 = OpFunction  %2  None %9
%18 = OpLabel
%20 = OpAccessChain  %10  %4 %11
OpBranch %21
%21 = OpLabel
%22 = OpLoad  %3  %20
%24 = OpFConvert  %23  %22
%25 = OpFConvert  %3  %24
OpStore %20 %25
OpReturn
OpFunctionEnd
%27 = OpFunction  %2  None %9
%26 = OpLabel
%28 = OpAccessChain  %10  %4 %11
OpBranch %30
%30 = OpLabel
%31 = OpLoad  %3  %28
%32 = OpFAdd  %3  %31 %29
OpStore %28 %32
OpReturn
OpFunctionEnd